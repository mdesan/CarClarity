{
  "name": "CarClarity",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": [
    "*://*.craigslist.org/*",
    "https://vpic.nhtsa.dot.gov/*",
    "https://api.nhtsa.gov/*",
    "https://www.fueleconomy.gov/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "32": "car-blue.png",
    "48": "car-blue-48.png",
    "96": "car-blue-96.png",
    "128": "car-blue-128.png"
  },
  "action": {
    "default_title": "Open CarClarity",
    "default_popup": "unsupported.html",
    "default_icon": "car-gray.png"
  }
}
